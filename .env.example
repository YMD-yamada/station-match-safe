# ローカル: SQLite
DATABASE_URL=sqlite:///./station_match.db
# 本番（推奨）: Neon 等の Postgres URI（Render の Environment に設定）
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

ALLOW_ORIGINS=http://localhost:8000
API_RATE_LIMIT_PER_MIN=60

# 本番では必ず強いランダム値に置き換え（32byte 以上推奨）
JWT_SECRET=replace-with-long-random-secret
# JWT_EXPIRE_DAYS=60

# 運用のみ: 未設定時 /safety/audit-logs は 404（非公開）。参照時は X-Audit-Key ヘッダを付ける
# AUDIT_LOG_API_KEY=

# 任意: 設定すると /metrics は X-Metrics-Key 必須。未設定なら開発利便のため公開のまま
# METRICS_API_KEY=
